# 全局唯一配置文件模板。复制为 .env 后修改：
#   cp .env.example .env
#
# 这一个文件同时被两处读取：
#   1. docker compose —— 用于 ${...} 变量替换（端口、镜像、密钥）
#   2. 后端 pydantic settings —— 本地开发 / 裸机部署时直接读它
# Docker 部署时 .env 不进镜像，应用的配置由 docker-compose.yml 的 environment 注入。
#
# 注意：ENVIRONMENT 不要写在这里。它在模块导入时就要用到，早于 .env 被读取，
# 只能通过系统环境变量设置（镜像里已固定为 production，本地默认 development）。

# ============ 服务 ============
# 宿主机映射端口
ANYROUTER_PORT=16168
# 镜像地址。仓库还没打过 v* tag 时 latest 不存在，可先用 :edge
ANYROUTER_IMAGE=ghcr.io/hearthealt/anyrouter-autosign:latest
TZ=Asia/Shanghai

# ============ 安全（必改）============
# JWT 签名密钥。不改等于没有鉴权：openssl rand -hex 32
JWT_SECRET_KEY=
# 首次启动会创建的管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ============ 一键更新 ============
# 页面「更新并重启」调用 watchtower HTTP API 的令牌，留空则更新按钮不可用
# 生成方式同上：openssl rand -hex 32
WATCHTOWER_HTTP_API_TOKEN=
# containrrr/watchtower 默认使用 Docker API 1.24；若 Docker Engine 的最低 API 更高，
# 不指定会报 "client version 1.24 is too old"。当前 1.40 兼容 Docker Engine 29.4。
# 若服务器版本不同，以 docker version 中 Server 的 API version 范围为准。
DOCKER_API_VERSION=1.40

# ============ 应用 ============
APP_NAME=AnyRouter Admin
DEBUG=false
DATABASE_URL=sqlite:///./data/anyrouter.db
LOG_LEVEL=INFO
# text（便于本地看）或 json（生产）
LOG_FORMAT=json
LOG_DIR=./logs

# ============ 请求与重试 ============
REQUEST_TIMEOUT=30
RETRY_TIMES=3
RETRY_INTERVAL=3

# ============ 高级（一般不用改）============
# 允许平台 Base URL 指向内网地址
# ALLOW_PRIVATE_PLATFORM_URLS=false
# 检查更新的 GitHub Releases 来源仓库
# GITHUB_REPO=hearthealt/anyrouter-autosign
